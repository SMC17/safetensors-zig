{
  "schema": 1,
  "project": "safetensors-zig",
  "visibility": "private",
  "systems": [
    "Darwin",
    "Linux"
  ],
  "required_files": [
    "README.md",
    "LICENSE",
    "STATUS.md",
    "AGENTS.md",
    "scripts/verify_inspect_task.py",
    "tests/fixtures/original-two-f32.safetensors"
  ],
  "task": "Inspect an original 128-byte tensor-header fixture and refuse six malformed or missing-input cases.",
  "steps": [
    {
      "name": "unit tests",
      "argv": [
        "zig",
        "build",
        "test",
        "-Doptimize=ReleaseSafe",
        "--summary",
        "all"
      ],
      "minimum_tests": 19
    },
    {
      "name": "install fixture binary",
      "argv": [
        "zig",
        "build",
        "-Doptimize=ReleaseSafe"
      ]
    },
    {
      "name": "original fixture and refusal task",
      "argv": [
        "python3",
        "scripts/verify_inspect_task.py"
      ],
      "contains": "\"status\": \"PASS\""
    }
  ],
  "bundle_paths": [
    "zig-out/bin/safetensors-inspect",
    "tests/fixtures/original-two-f32.safetensors"
  ],
  "limitations": [
    "One original synthetic tensor fixture; two optional model tests skip without their separately acquired inputs.",
    "No HuggingFace runtime parity or speed ratio was remeasured.",
    "Private working acceptance artifact, not a release cut. Repository policy requires green CI and operator intent for a release."
  ]
}
